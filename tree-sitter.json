{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "bend",
      "camelcase": "Bend",
      "title": "Bend",
      "scope": "source.bend",
      "path": ".",
      "file-types": [
        "bend"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm",
      "injection-regex": "^bend$",
      "class-name": "TreeSitterBend"
    }
  ],
  "metadata": {
    "version": "0.1.2",
    "license": "MIT",
    "description": "Bend grammar for tree-sitter",
    "authors": [
      {
        "name": "Amaan Qureshi",
        "email": "contact@amaanq.com"
      }
    ],
    "links": {
      "repository": "https://github.com/amaanq/tree-sitter-bend"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
